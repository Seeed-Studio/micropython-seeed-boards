diff --git a/ports/zephyr/modules/_boot.py b/ports/zephyr/modules/_boot.py
new file mode 100644
index 00000000000..af5d787d948
--- /dev/null
+++ b/ports/zephyr/modules/_boot.py
@@ -0,0 +1,86 @@
+# _boot.py - MicroPython startup helper (frozen into firmware).
+#
+# Called from main.c on every boot:
+#   1. First boot (blank storage): format the LittleFS partition.
+#   2. Every boot: clean up stale filesystem copies of frozen modules
+#      so that ``import`` always resolves to the frozen (firmware) version.
+#
+# After a firmware upgrade the frozen content changes but the filesystem
+# is preserved.  Without cleanup an old .py on /flash/ would shadow the
+# updated frozen module because MicroPython checks sys.path before frozen.
+#
+# zephyr.FlashArea.ID_storage resolves to the storage_partition fixed-partition
+# id at build time (0 on XIAO STM32C5) -- do NOT hardcode a numeric id, which
+# would target the wrong partition on other boards (e.g. nRF54L15).
+
+import os
+
+# -- Firmware version --
+# Bump this when frozen modules change so devices detect the upgrade.
+_FW_VERSION = "0.2.0"
+
+# Paths on the LittleFS filesystem that mirror frozen modules.
+_FROZEN_FILES = (
+    "_boot.py",
+    "xiao_stm32c5_full_test.py",
+    "boards/xiao.py",
+    "boards/xiao_stm32c5.py",
+)
+
+_MARKER = "/flash/.fw_version"
+
+
+def _read_marker():
+    try:
+        with open(_MARKER) as f:
+            return f.read().strip()
+    except Exception:
+        return None
+
+
+def _write_marker():
+    try:
+        with open(_MARKER, "w") as f:
+            f.write(_FW_VERSION)
+    except Exception:
+        pass
+
+
+def _cleanup():
+    """Delete filesystem copies of frozen modules so imports resolve
+    to the (updated) frozen versions compiled into the firmware."""
+    removed = 0
+    for name in _FROZEN_FILES:
+        path = "/flash/" + name
+        try:
+            os.remove(path)
+            removed += 1
+        except OSError:
+            pass
+    # Prune empty directories left behind.
+    for d in ("boards",):
+        try:
+            os.rmdir("/flash/" + d)
+        except OSError:
+            pass
+    if removed:
+        print("boot: cleaned {0} stale frozen-module copy(ies)".format(removed))
+
+
+# ---- main ----
+
+if _read_marker() is None:
+    # First boot or manually wiped storage -- format the partition.
+    try:
+        import zephyr
+        bdev = zephyr.FlashArea(zephyr.FlashArea.ID_storage, 4096)
+        os.VfsLfs2.mkfs(bdev)
+        print("boot: formatted storage partition")
+    except Exception as e:
+        print("boot: format storage failed:", e)
+    _write_marker()
+else:
+    # Normal boot -- clean stale frozen-module copies on firmware upgrade.
+    if _read_marker() != _FW_VERSION:
+        _cleanup()
+        _write_marker()
