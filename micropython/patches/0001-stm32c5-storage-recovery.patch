+    def uart(uart):
+        xiao_uart = {
+            "uart0": "uart20",
+            "uart1": "uart21",
+        }
+        return xiao_uart[uart]
+
+    def pdm(pdm):
+        xiao_pdm = {
+            "pdm0": "pdm20",
+        }
+        return xiao_pdm[pdm]
