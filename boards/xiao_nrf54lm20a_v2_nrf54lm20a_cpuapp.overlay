/* XIAO nRF54LM20A V2.0 MicroPython application overlay.
 *
 * V2.0 reuses the XIAO nRF54LM20B PCB with the nRF54LM20A SoC (no SAMD11
 * USB-UART bridge): the application console and MicroPython REPL run on
 * the nRF54 native USB CDC ACM device.
 */

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
        zephyr,uart-mcumgr = &cdc_acm_uart0;
        zephyr,bt-mon-uart = &cdc_acm_uart0;
        zephyr,bt-c2h-uart = &cdc_acm_uart0;
    };

    zephyr,user {
        io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>,
                       <&adc 4>, <&adc 5>, <&adc 6>, <&adc 7>;
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "XIAO nRF54LM20A V2 USB CDC ACM";
    };
};

/* The board revision overlay (_2_0_0.overlay) defines a second
 * zephyr,cdc-acm-uart node (cdc_acm_uart) for Zephyr's standalone CDC
 * serial backend, pulled in by the platform board Kconfig. MicroPython's
 * usbd.c owns the single USB device and registers one CDC ACM class per
 * enabled DT node, so leaving it on exposes TWO CDC interfaces with the
 * same VID:PID (two host COM ports) and opening the unused instance
 * kills the USB device (host write timeout, device gone until reset).
 * Disable it: MicroPython REPL is the only CDC this firmware exposes. */
&cdc_acm_uart {
    status = "disabled";
};

/* Remove the small internal-RRAM storage partition. */
/delete-node/ &storage_partition;

/* The board's user storage is the external 128-Mbit PY25Q128HA SPI NOR
 * (the part on the 20B PCB). Keep the MCUboot/app partitions in internal
 * RRAM and expose the external flash as the MicroPython filesystem block
 * device. */
&py25q128 {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@0 {
			label = "storage";
			reg = <0x0 0x1000000>;
		};
	};
};

/ {
    fstab {
        compatible = "zephyr,fstab";
        lfs1: lfs1 {
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/flash";
            partition = <&storage_partition>;
            automount;
            read-size = <32>;
            prog-size = <32>;
            cache-size = <128>;
            lookahead-size = <64>;
            block-cycles = <2048>;
        };
    };
};

&pdm20 {
    status = "okay";
};

&pwm20 {
    status = "okay";
};

&wdt31 {
    status = "okay";
};
